root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

[*.md]
max_line_length = off

[*.yml]
indent_size = 2

[**/src/main/resources/manifest.json]
insert_final_newline = false
trim_trailing_whitespace = false
