craftory.crew.usage = Use /craftory crew create <name>, invite <player>, accept <crew-id>, leave, kick <player>, or info [player].
craftory.crew.player-only = This command must be run by a player.
craftory.crew.invalid-name = Crew names must contain 1 to 32 characters.
craftory.crew.already-member = You are already in a crew.
craftory.crew.created = Created crew {name}.
craftory.crew.player-not-found = That player is not online.
craftory.crew.invite-failed = That player could not be invited.
craftory.crew.invited = Invited {player} to your crew.
craftory.crew.invite-received = {owner} invited you to {crew}. Accept with /craftory crew accept {id}.
craftory.crew.accept-failed = No matching crew invitation was found.
craftory.crew.accepted = You joined {crew}.
craftory.crew.not-in-crew = You are not in an explicit crew.
craftory.crew.left = You left the crew. Your unlocked pages were kept.
craftory.crew.kick-failed = You cannot kick that player from your crew.
craftory.crew.kicked = Removed {player} from your crew.
craftory.crew.kicked-from-crew = You were removed from the crew. Your unlocked pages were kept.
craftory.crew.permission = You do not have permission to inspect another player's crew.
craftory.crew.info = {name} | Tier {tier} | Pages {pages}: {known} | Members: {members}
craftory.crew.tier-advanced = Crew {name} reached tier {tier}: Tinkered.
craftory.grant.usage = Use /craftory grant <player> <namespaced-page-id>.
craftory.grant.invalid-id = Page IDs must be namespaced, for example craftory:page/burner.
craftory.grant.success = Granted {id} to {player}'s crew.
craftory.grant.already-known = {player}'s crew already knows {id}.
