$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;
  $C.@DecoratedContainer {
    Anchor: (Width: 560, Height: 480);
    #Title { $C.@Title { @Text = "Hurl Station"; } }
    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);
      Group #Rename {
        LayoutMode: Top;
        TextField #Name { Anchor: (Height: 40, Bottom: 12); }
        $C.@TextButton #Save { @Text = "Save"; Anchor: (Height: 40); }
      }
      Group #Picker {
        LayoutMode: Top;
        FlexWeight: 1;
        Label #Empty { Text: "No reachable destinations"; Anchor: (Height: 40); }
        Group #Destinations { LayoutMode: TopScrolling; FlexWeight: 1; }
      }
    }
  }
}
$C.@BackButton {}
