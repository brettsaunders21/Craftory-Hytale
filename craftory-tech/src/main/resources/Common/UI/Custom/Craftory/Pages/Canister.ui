$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 500);

    #Title {
      $C.@Title #TitleLabel {
        @Text = "Fizz Canister";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Group #EnergyBar {
        Anchor: (Bottom: 12);
      }

      Label #In {
        Text: "In: 0 Fizz/t";
        Anchor: (Bottom: 6);
      }

      Label #Out {
        Text: "Out: 0 Fizz/t";
        Anchor: (Bottom: 6);
      }

      Label #Members {
        Text: "Network members: 0";
        Anchor: (Bottom: 6);
      }

      Label #Grade {
        Text: "Grade: Fizz";
      }
    }
  }
}

$C.@BackButton {}
