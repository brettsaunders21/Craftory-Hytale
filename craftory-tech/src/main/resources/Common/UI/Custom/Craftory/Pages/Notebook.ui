$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 640);

    #Title {
      $C.@Title {
        @Text = "Tinker's Notebook";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #Crew {
        Text: "Crew: Solo";
        Anchor: (Bottom: 4);
      }

      Label #Members {
        Text: "Members: 1";
        Anchor: (Bottom: 4);
      }

      Label #Progress {
        Text: "0/8 pages";
        Anchor: (Bottom: 12);
      }

      Group #Page0 {
        LayoutMode: Left;
        Anchor: (Bottom: 5);
        Label #Name { Text: "Boomshroom burner"; FlexWeight: 1; }
        Label #Status { Text: "Missing"; Anchor: (Width: 72); }
        Label #Source { Text: "Source: machine"; Anchor: (Width: 190); }
      }
      Group #Page1 {
        LayoutMode: Left;
        Anchor: (Bottom: 5);
        Label #Name { Text: "Squeak-crank"; FlexWeight: 1; }
        Label #Status { Text: "Missing"; Anchor: (Width: 72); }
        Label #Source { Text: "Source: machine"; Anchor: (Width: 190); }
      }
      Group #Page2 {
        LayoutMode: Left;
        Anchor: (Bottom: 5);
        Label #Name { Text: "Fizz canister"; FlexWeight: 1; }
        Label #Status { Text: "Missing"; Anchor: (Width: 72); }
        Label #Source { Text: "Source: machine"; Anchor: (Width: 190); }
      }
      Group #Page3 {
        LayoutMode: Left;
        Anchor: (Bottom: 5);
        Label #Name { Text: "Gutterpipe"; FlexWeight: 1; }
        Label #Status { Text: "Missing"; Anchor: (Width: 72); }
        Label #Source { Text: "Source: machine"; Anchor: (Width: 190); }
      }
      Group #Page4 {
        LayoutMode: Left;
        Anchor: (Bottom: 5);
        Label #Name { Text: "Gnasher pit"; FlexWeight: 1; }
        Label #Status { Text: "Missing"; Anchor: (Width: 72); }
        Label #Source { Text: "Source: machine"; Anchor: (Width: 190); }
      }
      Group #Page5 {
        LayoutMode: Left;
        Anchor: (Bottom: 5);
        Label #Name { Text: "Scorch oven"; FlexWeight: 1; }
        Label #Status { Text: "Missing"; Anchor: (Width: 72); }
        Label #Source { Text: "Source: machine"; Anchor: (Width: 190); }
      }
      Group #Page6 {
        LayoutMode: Left;
        Anchor: (Bottom: 5);
        Label #Name { Text: "Grizzlecog's delivery"; FlexWeight: 1; }
        Label #Status { Text: "Missing"; Anchor: (Width: 72); }
        Label #Source { Text: "Source: receipt"; Anchor: (Width: 190); }
      }
      Group #Page7 {
        LayoutMode: Left;
        Label #Name { Text: "Scrap Rush"; FlexWeight: 1; }
        Label #Status { Text: "Missing"; Anchor: (Width: 72); }
        Label #Source { Text: "Source: admin grant"; Anchor: (Width: 190); }
      }
    }
  }
}

$C.@BackButton {}
