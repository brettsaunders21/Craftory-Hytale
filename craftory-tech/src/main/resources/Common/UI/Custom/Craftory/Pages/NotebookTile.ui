$C = "../../Common.ui";
$Sounds = "../../Sounds.ui";

Group {
  Anchor: (Width: 144, Height: 176, Right: 16, Bottom: 16);
  Padding: (Full: 0);

  Group #EmptyBackground {
    Visible: false;
    Background: (TexturePath: "../../Pages/Memories/Tiles/TileEmpty.png", Border: 8);
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
  }

  TextButton #ButtonNotSelected {
    Visible: false;
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
    Style: (
      Sounds: $Sounds.@ButtonsLight,
      Default: (
        LabelStyle: (
          Wrap: true,
          HorizontalAlignment: Center,
          VerticalAlignment: Center,
        ),
        Background: (TexturePath: "../../Pages/Memories/Tiles/TileDefault.png", Border: 8),
      ),
      Hovered: (
        LabelStyle: (
          Wrap: true,
          HorizontalAlignment: Center,
          VerticalAlignment: Center,
        ),
        Background: (TexturePath: "../../Pages/Memories/Tiles/TileHovered.png", Border: 8),
      )
    );
    FlexWeight: 1;
  }

  TextButton #ButtonSelected {
    Visible: false;
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
    Style: (
      Sounds: $Sounds.@ButtonsLight,
      Default: (
        LabelStyle: (
          Wrap: true,
          HorizontalAlignment: Center,
          VerticalAlignment: Center,
        ),
        Background: (TexturePath: "../../Pages/Memories/Tiles/TileSelected.png", Border: 8),
      )
    );
    FlexWeight: 1;
  }

  Group {
    LayoutMode: Middle;
    Anchor: (Full: 0);

    AssetImage #Icon {
      Anchor: (Width: 112, Height: 112);
      FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
    }
  }

  Group #LockedShade {
    Visible: false;
    Background: #000000(0.55);
    Anchor: (Width: 112, Height: 112);
  }

  Group #FoundMark {
    Visible: false;
    Background: "../../Pages/Memories/Checkmark.png";
    Anchor: (Width: 16, Height: 16, Right: 10, Top: 10);
  }

  Label #TileName {
    Anchor: (Bottom: 6, Left: 8, Right: 8, Height: 34);
    Style: (
      FontSize: 13,
      HorizontalAlignment: Center,
      VerticalAlignment: Center,
      Wrap: true,
      TextColor: #b4c8c9
    );
    Text: "";
  }
}
